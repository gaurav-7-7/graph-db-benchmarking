# ------ Benchmark Config --------------------------------------------
# How many start nodes to use for traversal queries
TRAVERSAL_SAMPLE_SIZE=50

# Iterations per query per start node (for p50/p95 stability)
BENCHMARK_ITERATIONS=100

# Warm-up iterations before measurement begins
WARMUP_ITERATIONS=10

# Concurrency levels for mixed workload test
MIXED_CONCURRENCY=1,10,40

# Mixed workload duration in seconds per concurrency level
MIXED_DURATION_SECONDS=30

# Random seed for reproducibility (sampling, start node selection)
RANDOM_SEED=42
