# ============================================================
# CognoDB Benchmarking — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.

# ------ CognoDB Cloud -----------------------------------------------
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your-cognodb-password-here

# ------ Neo4j AuraDB Free -------------------------------------------
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-auradb-password-here

# ------ Memgraph Cloud ----------------------------------------------
MEMGRAPH_URI=bolt+s://<instance-id>.memgraph.io
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=your-memgraph-password-here

# ------ FalkorDB (local Docker) -------------------------------------
FALKORDB_URI=bolt://localhost:7688
FALKORDB_USER=
FALKORDB_PASSWORD=

# ------ ArangoDB (local Docker) -------------------------------------
ARANGO_URI=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=benchmarkpass
ARANGO_DB=benchmark

# ------ Benchmark Config --------------------------------------------
# How many start nodes to use for traversal queries
TRAVERSAL_SAMPLE_SIZE=50

# Iterations per query per start node (for p50/p95 stability)
BENCHMARK_ITERATIONS=100

# Warm-up iterations before measurement begins
WARMUP_ITERATIONS=10

# Concurrency levels for mixed workload test
MIXED_CONCURRENCY=1,10,40

# Mixed workload duration in seconds per concurrency level
MIXED_DURATION_SECONDS=30

# Random seed for reproducibility (sampling, start node selection)
RANDOM_SEED=42
